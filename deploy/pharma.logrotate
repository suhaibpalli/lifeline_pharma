/home/suhaib/pharma/logs/*.log {
    daily
    rotate 90
    maxsize 20M
    missingok
    notifempty
    compress
    delaycompress
    su suhaib suhaib
    create 0640 suhaib suhaib
    sharedscripts
    postrotate
        /usr/bin/systemctl kill --kill-whom=main --signal=USR1 pharma.service >/dev/null 2>&1 || true
    endscript
}
